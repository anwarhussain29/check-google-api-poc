# Neon Postgres (set automatically on Vercel by the Neon integration; `vercel env pull .env` copies them locally)
# Pooled connection used by the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection used by Prisma migrations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Server-side key: Geocoding API + Solar API
GOOGLE_MAPS_API_KEY=""

# Browser key: Maps JavaScript API (can be the same key, restrict by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Absolute site URL used for Open Graph link previews. On Vercel this falls back to the deployment URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
